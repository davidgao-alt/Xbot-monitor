# =========================================================
# XBot Monitor config
# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real keys.
# =========================================================

# ---------- Required ----------

# SocialData API key (https://socialdata.tools → Dashboard → API key)
SOCIALDATA_API_KEY=

# Telegram bot token from @BotFather
TG_BOT_TOKEN=

# Chat that receives the posts (groups look like -100xxxxxxxxxx or -xxxxxxxxx)
TG_CHAT_ID=


# ---------- Optional (defaults shown) ----------

# Where error alerts go (SocialData balance empty, bad API key).
# Defaults to TG_CHAT_ID; set it to your own chat to keep the group clean.
# TG_ALERT_CHAT_ID=

# Files. Relative paths are resolved against the repo directory.
# ACCOUNTS_FILE=config/accounts.json
# KEYWORDS_FILE=config/keywords.json
# DATA_DIR=data
# SEEN_FILE=data/seen_ids.json
# STATE_FILE=data/state.json

# How far back to look on the first run, for new accounts, or after downtime.
# Normal runs only fetch posts since the previous run.
# LOOKBACK_HOURS=24

# Each run re-checks this many seconds before the previous run,
# because X's search index can lag slightly behind new posts.
# OVERLAP_SECONDS=120

# Accounts combined into one search query: (from:a OR from:b ...).
# Set to 1 to query each account separately.
# ACCOUNTS_PER_QUERY=10

# Safety cap on result pages per query (~20 tweets per page).
# MAX_PAGES_PER_QUERY=15

# Pause between SocialData requests, in seconds (limit is 120 requests/min).
# SOCIALDATA_REQUEST_DELAY=0.7

# Also match keywords in the post being quoted.
# MATCH_QUOTED_TWEETS=true

# Pause between Telegram messages, in seconds.
# TG_SEND_DELAY=1.5

# How long sent post ids are remembered, for de-duplication.
# SEEN_RETENTION_DAYS=30

# Minimum hours between repeated error alerts.
# ALERT_COOLDOWN_HOURS=6

# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
